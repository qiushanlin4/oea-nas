# 脚本必须保持 LF —— 这些文件是要拷到 Linux 板子上运行的。
# Windows 的 CRLF 会让 /bin/sh 报 "bad interpreter: /bin/sh^M"。
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
patches/*       text eol=lf

# PowerShell / cmd 保持 CRLF
*.ps1           text eol=crlf
*.cmd           text eol=crlf

# C# 无所谓，统一 LF
*.cs            text eol=lf
*.csproj        text eol=lf

# 文档
*.md            text eol=lf
LICENSE         text eol=lf

# 二进制
*.img           binary
*.bin           binary
